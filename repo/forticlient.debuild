forticlient__version-pre() {
    true
}

forticlient__get-sources() {
    curl -o forticlient.deb -L https://links.fortinet.com/forticlient/deb/vpnagent
}

forticlient__build() {
    destination="$1"
    cp forticlient.deb "$destination/forticlient_$(forticlient__version)_amd64.deb"
}

forticlient__version() {
    if [ ! -f /src/DEBIAN/control ]; then
        dpkg -e /src/forticlient.deb
    fi
    cat /src/DEBIAN/control | awk '/Version/ { print $2 }'
}
